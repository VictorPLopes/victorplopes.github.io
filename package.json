{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "transloco:optimize": "transloco-optimize dist/lokalise-transloco-tutorial/browser/assets/i18n",
    "build:prod": "ng build --aot && npm run transloco:optimize",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-locale": "^8.4.0",
    "@jsverse/transloco-persist-lang": "^8.4.0",
    "@jsverse/transloco-schematics": "^8.4.0",
    "angular-cli-ghpages": "^3.1.0",
    "file-system": "^2.2.2",
    "ng2-pdf-viewer": "^10.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@jsverse/transloco-optimize": "^8.4.0",
    "@types/jasmine": "~6.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "canvas@3.2.3": true,
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true,
    "lmdb@3.5.6": true
  }
}
